# Copy to ".env" if you like — or just set these in the terminal before "npm start".
# (The server reads real environment variables; it does not load a .env file by itself, so
#  on Windows PowerShell use:  $env:PORT=3100; npm start     and on macOS/Linux:  PORT=3100 npm start)

# Port the garden server listens on.                                  (default 3000)
PORT=3000

# Network interface to listen on. 0.0.0.0 = reachable from phones on your Wi-Fi.
# Use 127.0.0.1 to keep the server private to this computer.          (default 0.0.0.0)
HOST=0.0.0.0

# Address printed in the QR code, when the automatic one is wrong.
# Example: 192.168.1.20  or  192.168.1.20:3000. Can also be changed live in the host panel.
# PUBLIC_HOST=192.168.1.20

# Where the database and uploaded (resized) photographs are kept.      (default ./data)
DATA_DIR=./data

# How long a session lives before everything in it is deleted.         (default 4)
SESSION_TTL_HOURS=4

# Largest photograph a phone may send, in megabytes.                   (default 10)
MAX_UPLOAD_MB=10

# Set to 1 only if you really need to create sessions from another computer. Not recommended.
# ALLOW_REMOTE_HOST=1

# Set to 1 to print one line per request (tokens are always redacted).
# LOG_REQUESTS=1
